<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Blueprint Training Centre — Preloader</title>
<style>
  :root{
    --bg:#ffffff;
    --navy:#0f2456;
    --navy-deep:#0a1a3c;
    --navy-line:#0f2456;
    --gold:#e8a838;
    --gold-soft:#c98a1e;
    --ink:#0f2456;
  }

  *{box-sizing:border-box;}

  html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    background:var(--bg);
    overflow:hidden;
    font-family:'Segoe UI', Helvetica, Arial, sans-serif;
  }

  .stage{
    position:relative;
    width:100%;
    height:100vh;
    min-height:480px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
      radial-gradient(ellipse at 50% 40%, rgba(232,168,56,0.06), transparent 55%),
      var(--bg);
  }

  /* blueprint grid, drifting slowly like a drafting table */
  .grid{
    position:absolute;
    inset:-2px;
    background-image:
      linear-gradient(var(--navy-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--navy-line) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity:0.06;
    animation: driftGrid 16s linear infinite;
    mask-image: radial-gradient(ellipse at 50% 45%, black 35%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 45%, black 35%, transparent 78%);
  }
  @keyframes driftGrid{
    from{ background-position: 0 0; }
    to{ background-position: 42px 42px; }
  }

  /* faint corner crop-marks, drafting-plan feel */
  .crop{
    position:absolute;
    width:26px; height:26px;
    border-color: rgba(232,168,56,0.55);
    border-style:solid;
    opacity:0;
    animation: fadeCrop .6s ease-out forwards;
  }
  .crop.tl{ top:34px; left:34px; border-width:2px 0 0 2px; animation-delay:.05s; }
  .crop.tr{ top:34px; right:34px; border-width:2px 2px 0 0; animation-delay:.1s; }
  .crop.bl{ bottom:34px; left:34px; border-width:0 0 2px 2px; animation-delay:.15s; }
  .crop.br{ bottom:34px; right:34px; border-width:0 2px 2px 0; animation-delay:.2s; }
  @keyframes fadeCrop{ to{ opacity:1; } }

  .content{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:22px;
  }

  /* logo reveal rig */
  .logo-wrap{
    position:relative;
    width:280px;
    height:280px;
  }

  .logo-img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:contain;
    filter: drop-shadow(0 0 22px rgba(232,168,56,0.0));
    clip-path: inset(0 100% 0 0);
    animation:
      reveal .55s cubic-bezier(.22,.8,.28,1) .05s forwards,
      settle-glow 1.6s ease-in-out .6s infinite;
  }

  @keyframes reveal{
    to{ clip-path: inset(0 0% 0 0); }
  }
  @keyframes settle-glow{
    0%,100%{ filter: drop-shadow(0 0 6px rgba(232,168,56,0.12)); }
    50%{ filter: drop-shadow(0 0 14px rgba(232,168,56,0.28)); }
  }

  /* the scanning/plotting line that "draws" the logo as it reveals */
  .scan-line{
    position:absolute;
    top:6%;
    bottom:6%;
    width:3px;
    left:0%;
    background: linear-gradient(180deg, transparent, var(--gold-soft) 15%, var(--gold) 50%, var(--gold-soft) 85%, transparent);
    box-shadow: 0 0 14px 2px rgba(232,168,56,0.85);
    opacity:0;
    animation: scan .55s cubic-bezier(.22,.8,.28,1) .05s forwards;
  }
  @keyframes scan{
    0%{ left:0%; opacity:1; }
    92%{ opacity:1; }
    100%{ left:100%; opacity:0; }
  }

  /* wordmark + tagline fade up after logo lands */
  .type-block{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    opacity:0;
    transform:translateY(10px);
    animation: riseIn .35s ease-out .55s forwards;
  }
  @keyframes riseIn{
    to{ opacity:1; transform:translateY(0); }
  }

  .brand-line{
    display:flex;
    align-items:baseline;
    gap:10px;
    color:var(--ink);
    letter-spacing:2px;
  }
  .brand-line .big{
    font-size:26px;
    font-weight:800;
    color:var(--navy);
  }
  .brand-line .small{
    font-size:14px;
    font-weight:600;
    color:var(--gold-soft);
    letter-spacing:4px;
  }

  .rule{
    width:150px;
    height:1px;
    background: rgba(15,36,86,0.15);
    position:relative;
    overflow:hidden;
  }
  .rule::after{
    content:'';
    position:absolute;
    inset:0;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin:left;
    animation: ruleFill .3s ease-out .65s forwards;
  }
  @keyframes ruleFill{ to{ transform: scaleX(1); } }

  /* progress: blueprint ruler / tick style */
  .progress{
    width:190px;
    margin-top:2px;
    opacity:0;
    animation: riseIn .3s ease-out .7s forwards;
  }
  .progress-track{
    position:relative;
    width:100%;
    height:6px;
    border:1px solid rgba(232,168,56,0.55);
    border-radius:3px;
    overflow:hidden;
    background: rgba(15,36,86,0.04);
  }
  .progress-fill{
    position:absolute;
    inset:0;
    width:0%;
    background: linear-gradient(90deg, var(--gold), var(--gold-soft));
    border-radius:3px;
    animation: fillBar .3s cubic-bezier(.4,0,.2,1) .7s forwards;
  }
  @keyframes fillBar{
    0%{ width:0%; }
    100%{ width:100%; }
  }
  .ticks{
    display:flex;
    justify-content:space-between;
    margin-top:5px;
  }
  .ticks span{
    width:1px;
    height:4px;
    background: rgba(15,36,86,0.25);
  }

  .status-text{
    margin-top:2px;
    font-size:10.5px;
    letter-spacing:3px;
    color: rgba(15,36,86,0.45);
    text-transform:uppercase;
    font-weight:600;
  }

  /* zoom-through-the-P dive transition, fired 1s in, ends on navigation */
  .content{
    will-change: transform, opacity;
  }
  .stage.diving .content{
    animation: diveZoom .8s cubic-bezier(.55,0,1,.45) forwards;
  }
  @keyframes diveZoom{
    0%{ transform: scale(1); opacity:1; }
    50%{ opacity:1; }
    100%{ transform: scale(26); opacity:0; }
  }
  .stage.diving .grid{
    animation: gridPullIn .8s ease-in forwards;
  }
  @keyframes gridPullIn{
    to{ transform: scale(5); opacity:0; }
  }
  .stage.diving .crop{
    animation: cropFadeOut .3s ease-in forwards;
  }
  @keyframes cropFadeOut{ to{ opacity:0; } }

  .dive-flash{
    position:absolute;
    inset:0;
    background:#ffffff;
    opacity:0;
    pointer-events:none;
    z-index:5;
  }
  .stage.diving .dive-flash{
    animation: diveFlash .8s ease-in forwards;
  }
  @keyframes diveFlash{
    0%{ opacity:0; }
    65%{ opacity:0; }
    100%{ opacity:1; }
  }

  @media (prefers-reduced-motion: reduce){
    .logo-img, .scan-line, .type-block, .rule::after, .progress, .progress-fill, .grid, .crop{
      animation-duration:.01s !important;
      animation-iteration-count:1 !important;
    }
    .logo-img{ clip-path: inset(0 0 0 0); }
    .stage.diving .content, .stage.diving .grid{
      animation-duration:.01s !important;
    }
  }
</style>
</head>
<body>

<div class="stage">
  <div class="grid"></div>
  <div class="crop tl"></div>
  <div class="crop tr"></div>
  <div class="crop bl"></div>
  <div class="crop br"></div>

  <div class="content">
    <div class="logo-wrap">
      <img class="logo-img" src="data:image/png;base64," alt="Blueprint Training Centre logo" />
      <div class="scan-line"></div>
    </div>

    <div class="type-block">
      <div class="brand-line">
        <span class="big">B</span><span class="big">L</span><span class="big">U</span><span class="big">E</span><span class="big" id="letterP">P</span><span class="big">R</span><span class="big">I</span><span class="big">N</span><span class="big">T</span>
        <span class="small">TRAINING CENTRE</span>
      </div>
      <div class="rule"></div>
    </div>

    <div class="progress">
      <div class="progress-track">
        <div class="progress-fill"></div>
      </div>
      <div class="ticks">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="status-text">Loading&nbsp;plans&hellip;</div>
    </div>
  </div>

  <div class="dive-flash"></div>
</div>

<script>
(function(){
  var pEl = document.getElementById('letterP');
  var content = document.querySelector('.content');
  var stage = document.querySelector('.stage');
  var navigateTo = 'index.html'; // change this to your real landing page if needed

  function setDiveOrigin(){
    var pRect = pEl.getBoundingClientRect();
    var cRect = content.getBoundingClientRect();
    // aim at the P's bowl (the letter's hole), not its full bounding box centre
    var ox = ((pRect.left + pRect.width * 0.58) - cRect.left) / cRect.width * 100;
    var oy = ((pRect.top + pRect.height * 0.34) - cRect.top) / cRect.height * 100;
    content.style.transformOrigin = ox + '% ' + oy + '%';
  }

  setDiveOrigin();
  window.addEventListener('resize', setDiveOrigin);

  // at 1s: dive through the hole of the P
  setTimeout(function(){
    setDiveOrigin();
    stage.classList.add('diving');
  }, 1000);

  // once the dive animation finishes: hand off to the real page
  setTimeout(function(){
    window.location.href = navigateTo;
  }, 1000 + 800);
})();
</script>

</body>
</html>